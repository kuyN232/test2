!#/bin/bash
cd /etc/net/ifaces/
mkdir ens224 ens224.100 ens224.200 ens224.999 iptunnel
cd /etc/net/ifaces/ens224
touch ipv4address options ipv4route
echo "#172.16.14.1/28
" >> ipv4address
echo "TYPE=eth
BOOTPROTO=static
DISABLED=no
CONFIG_IPV4=yes
" >> options
cd /etc/net/ifaces/ens224.100
touch ipv4address options ipv4route
echo "172.16.100.1/28
" >> ipv4address
echo "TYPE=vlan
HOST=ens224
VID=100
ONBOOT=yes
CONFIG_WIRELESS=no
CONFIG_IPV4=yes
BOOTPROTO=static
DISABLED=no
CONFIG_IPV4=yes
" >> options
cd /etc/net/ifaces/ens224.200
touch ipv4address options ipv4route
echo "172.16.200.1/28
" >> ipv4address
echo "TYPE=vlan
HOST=ens224
VID=200
ONBOOT=yes
CONFIG_WIRELESS=no
CONFIG_IPV4=yes
BOOTPROTO=static
DISABLED=no
CONFIG_IPV4=yes
" >> options
cd /etc/net/ifaces/ens224.999
touch ipv4address options ipv4route
echo "172.16.99.1/28
" >> ipv4address
echo "TYPE=vlan
HOST=ens224
VID=999
ONBOOT=yes
CONFIG_WIRELESS=no
CONFIG_IPV4=yes
BOOTPROTO=static
DISABLED=no
CONFIG_IPV4=yes
" >> options
cd /etc/net/ifaces/iptunnel
touch ipv4address options ipv4route
echo "172.16.77.1/28
" >> ipv4address
echo "TYPE=iptun
TUNTYPE=gre # тип туннеля
TUNLOCAL=172.16.4.2
TUNREMOTE=172.16.5.2
" >> options
echo "172.16.77.1/28
" >> ipv4address
echo "172.16.77.0/28 via 172.16.77.1
" >> ipv4route
apt-get update
apt-get install -y nftables
systemctl enable --now nftables
nft add table ip nat
nft add chain ip nat postrouting '{ type nat hook postrouting priority 0; }'
nft add rule ip nat postrouting ip saddr 172.16.100.0/24 oifname "ens192" counter masquerade
nft add rule ip nat postrouting ip saddr 172.16.200.0/24 oifname "ens192" counter masquerade
nft list ruleset | tail -n7 | tee -a /etc/nftables/nftables.nft
systemctl restart network
apt-get install -y bind
cd /var/lib/bind/etc
echo "include "/ect/bind/rfc1912.conf";
zone "au-team.irpo" {
    type master;
    file "test.db";
};

zone "100.16.172.in-addr.arpa" {
    type master;
    file "17216100";
};
zone "200.16.172.in-addr.arpa" {
    type master;
    file "17216200";
};
" >> local.conf
cd /var/lib/bind/etc/bind/zone
touch 17216100.db
echo "$TTL  1D
@    IN    SOA  au-team.irpo. root.au-team.irpo. (
                2025020600    ; serial
                12H           ; refresh
                1H            ; retry
                1W            ; expire
                1H            ; ncache
            )
     IN    NS     au-team.irpo
1    IN    PRT    hq-rtr.au-team.irpo.
2    IN    PTR    hq-srv.au-team.irpo.
" >> 17216100.db
cd /var/lib/bind/etc/bind/zone
touch 17216200.db
echo "$TTL  1D
@    IN    SOA  au-team.irpo. root.au-team.irpo. (
                2025020600    ; serial
                12H           ; refresh
                1H            ; retry
                1W            ; expire
                1H            ; ncache
            )
      IN    NS     au-team.irpo
10    IN    PRT    hq-cli.au-team.irpo.
" >> 17216200.db
cd /var/lib/bind/etc/~bind/~zone
echo "$TTL  1D
@    IN    SOA  au-team.irpo. root.au-team.irpo. (
                2025020600    ; serial
                12H           ; refresh
                1H            ; retry
                1W            ; expire
                1H            ; ncache
            )
        IN    NS     au-team.irpo
        IN    A        127.0.0.1
hq-rtr  IN    A        172.16.100.1
br-rtr  IN    A        172.16.77.2
hq-srv  IN    A        172.16.100.2
hq-cli  IN    A        172.16.200.10
br-srv  IN    A        172.16.15.2
moodle  IN    CNAME    hq-rtr
wiki    IN    CNAME    hq-rtr
" >> test.db
apt-get install -y ntpd
ntpd 193.238.131.93
clear
date
ip a
host 172.16.200.10
host 172.16.100.1
host 172.16.100.2
host wiki.au-team.irpo
hostnamectl set-hostname HQ-RTR; exec bash
